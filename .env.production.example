# ============================================
# Werewolf Game — Production Environment
# ============================================
# Copy this file to .env.production and fill in values
# Usage: cp .env.production.example .env.production

# ─── Database ───
POSTGRES_DB=werewolf
POSTGRES_USER=werewolf
POSTGRES_PASSWORD=CHANGE_ME_strong_password_here

# ─── Redis ───
REDIS_PASSWORD=CHANGE_ME_strong_redis_password

# ─── JWT Secrets (generate with: openssl rand -base64 64) ───
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_64
JWT_REFRESH_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_64

# ─── App URLs ───
# Replace YOUR_SERVER_IP or YOUR_DOMAIN with your actual server IP or domain
CORS_ORIGIN=http://YOUR_DOMAIN_OR_IP
NEXT_PUBLIC_API_URL=http://YOUR_DOMAIN_OR_IP/api
NEXT_PUBLIC_WS_URL=http://YOUR_DOMAIN_OR_IP
NEXT_PUBLIC_APP_NAME=Werewolf Game
NEXT_PUBLIC_DEFAULT_LOCALE=en

# ─── Port (nginx listens on this) ───
APP_PORT=80
